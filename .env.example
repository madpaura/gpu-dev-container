# ── Agent Configuration ──────────────────────────────────────────
AGENT_PORT=8510           # Port the agent service listens on
MGMT_SERVER_IP=localhost  # IP of the admin/management server
MGMT_SERVER_PORT=8500     # Port of the admin/management server

# ── Host Paths ───────────────────────────────────────────────────
HOST_HOME=/home/vishwa    # Host home directory mounted into containers
HOST_OPT=/opt             # Host /opt directory mounted into containers

# ── Docker Container Defaults ────────────────────────────────────
DOCKER_IMAGE=gpu-dev-environment
DOCKER_TAG=latest
DOCKER_HOSTNAME=cxl-dev
DOCKER_CPU=4
DOCKER_CPU_PERCENT=100
DOCKER_MEM_LMT=4g
DOCKER_MEM_SWAP=5g

# ── Code Server ──────────────────────────────────────────────────
CODE_DEFAULT_WORKSPACE=/workspace
CODE_PORT=8080
CODE_CONFIG_MOUNT=/config
SUDO_PASSWORD=changeme    # CHANGE THIS before deploying

# ── Jupyter ──────────────────────────────────────────────────────
JUPYTER_PORT=8888

# ── Mount Points ─────────────────────────────────────────────────
QVP_BINARY_MOUNT=/opt/qvp
GUEST_OS_MOUNT=/opt/os/guestos
TOOLS_MOUNT=/opt/tools
WORKDIR_TEMPLATE=/home/vishwa/template/
WORKDIR_DEPLOY=/home/vishwa/vms/

# ── Admin Stack ──────────────────────────────────────────────────
BACKEND_PORT=8500         # Flask backend port
FRONTEND_PORT=9000        # nginx frontend port exposed to host

# ── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_DB=gpu_dash
POSTGRES_USER=gpu_dash
POSTGRES_PASSWORD=changeme   # CHANGE THIS before deploying
PG_DATA_VOLUME=./volumes/postgres
POSTGRES_PORT=5432

# ── Admin Bootstrap ──────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme      # CHANGE THIS before deploying
ADMIN_EMAIL=admin@example.com

# ── Nginx Config (managed by NginxService at runtime) ───────────
NGINX_CONFIG_FILE=/etc/nginx/sites-available/dev-services
